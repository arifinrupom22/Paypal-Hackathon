# PostgreSQL connection string
DATABASE_URL=

# Google Gemini API key used by the mandate parser and the purchasing agent.
# When absent, PACT uses its labeled deterministic fallback parser.
GEMINI_API_KEY=

# PayPal REST Orders API v2 (Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_WEBHOOK_ID=

# Ed25519 mandate signing key pair (base64 DER, PKCS8 private / SPKI public).
# Generate fresh values with: npm run keys:generate
# Never copy a sample key from this template into a real environment.
PACT_PRIVATE_KEY=
PACT_PUBLIC_KEY=

# Secret used to sign session-derived tokens and to derive local encryption keys.
# Generate a fresh value with: openssl rand -base64 48
AUTH_SECRET=

# Public origin used for PayPal return/cancel URLs. For a real Sandbox run this must be the
# exact HTTPS public deployment origin (no trailing path).
APP_URL=http://localhost:3000